# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environments ---
.venv/
venv/

# --- ROS 2 colcon (workspace root only) ---
/install
/build
/log

# --- ML weights (large / machine-specific) ---
# To track a specific small ONNX, add a negated rule, e.g.:
#   !src/dddnav_semantic_segmentation/model/foo.onnx
*.trt
*.pt
*.onnx

# --- Maps generated locally after mapping (binary, large) ---
src/dddnav_bringup/map/**/*.pcd

# --- ROS 2 bag files (record locally, not committed) ---
src/dddnav_odom_3d/bag_files/**/*.db3
src/dddnav_odom_3d/bag_files/**/metadata.yaml
src/dddnav_odom_3d/bag_files/**/*.mcap

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
